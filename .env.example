# Copy this file to ".env" for the LOCAL route (Route B).
# For the CLOUD route (Route A), you don't use this file. You put these same
# values into GitHub > Settings > Secrets and variables > Actions instead.
#
# Never commit your real .env or config.json. They're gitignored for you.

MONITOR_URL=https://example.com
# A word or phrase that should appear on the page.
MONITOR_KEYWORD=Example Domain

# From @BotFather when you create your bot (placeholder, not a real token):
TELEGRAM_BOT_TOKEN=123456789:PASTE_YOUR_TOKEN_HERE

# Your numeric Telegram id (from @userinfobot). Comma-separate to notify more
# than one chat, e.g. your own id plus a shared team chat.
TELEGRAM_CHAT_IDS=123456789

# Warn when the HTTPS cert has this many days or fewer left.
EXPIRY_WARN_DAYS=10
